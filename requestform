    private void btnSubmitActionPerformed(java.awt.event.ActionEvent evt) {                                          
       String residentName = loggedInResidentName.isEmpty()
            ? txtResidentName.getText().trim()
            : loggedInResidentName;

    String contactNum = txtContactNum.getText().trim();
    String document = cmbDocument.getSelectedItem().toString();
    String reason = cmbReason.getSelectedItem().toString();
    String dateText = txtDate.getText().trim();
    String time = cmbTime.getSelectedItem().toString();

    if (residentName.isEmpty() || contactNum.isEmpty()
            || dateText.isEmpty()) {
        JOptionPane.showMessageDialog(
                this, "Please complete all required information.");
        return;
    }

    if (conn == null) {
        JOptionPane.showMessageDialog(
                this, "Database is not connected.",
                "Database Error", JOptionPane.ERROR_MESSAGE);
        return;
    }

    // Accept dates such as October 19, 2026
    java.sql.Date requestDate;

    try {
        java.text.SimpleDateFormat sdf =
                new java.text.SimpleDateFormat("MMMM d, yyyy",
                        java.util.Locale.ENGLISH);

        sdf.setLenient(false);
        java.util.Date parsedDate = sdf.parse(dateText);

        // Reject invalid or partially parsed dates
        if (!sdf.format(parsedDate).equalsIgnoreCase(dateText)) {
            throw new java.text.ParseException(
                    "Invalid date format", 0);
        }

        requestDate = new java.sql.Date(parsedDate.getTime());

    } catch (java.text.ParseException e) {
        JOptionPane.showMessageDialog(
                this,
                "Enter the date in this format: October 19, 2026",
                "Invalid Date",
                JOptionPane.WARNING_MESSAGE);
        return;
    }

    String sql = "INSERT INTO requestform "
            + "(Residentname, contactnumber, document, "
            + "`date`, `time`, reason, status, date_requested) "
            + "VALUES (?, ?, ?, ?, ?, ?, 'Pending', NOW())";

    try (PreparedStatement pst = conn.prepareStatement(sql)) {

        pst.setString(1, residentName);
        pst.setString(2, contactNum);
        pst.setString(3, document);
        pst.setDate(4, requestDate);
        pst.setString(5, time);
        pst.setString(6, reason);

        int rows = pst.executeUpdate();

        if (rows > 0) {
            JOptionPane.showMessageDialog(
                    this,
                    "Request submitted successfully!",
                    "Success",
                    JOptionPane.INFORMATION_MESSAGE);

            ResidentMenu menu = new ResidentMenu(residentName);
            menu.setLocationRelativeTo(null);
            menu.setVisible(true);
            this.dispose();
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(
                this,
                "Could not save request:\n" + e.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE);

        e.printStackTrace();
    }
    }                                         

