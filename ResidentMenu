    private void btnRequestFormActionPerformed(java.awt.event.ActionEvent evt) {                                               
        RequestFormJframe form = new RequestFormJframe(loggedInResidentName);
        form.setLocationRelativeTo(null);
        form.setVisible(true);

      this.dispose();
    }                                              

    private void btnMyInformationActionPerformed(java.awt.event.ActionEvent evt) {                                                 
        MyInformation info = new MyInformation();
        info.setVisible(true);
        info.pack();
        info.setLocationRelativeTo(null);

      this.dispose();
    }                                                

    private void btnMyStatusActionPerformed(java.awt.event.ActionEvent evt) {                                            
         String fullName = loggedInResidentName == null
            ? ""
            : loggedInResidentName.trim();

    if (fullName.isEmpty()) {
        JOptionPane.showMessageDialog(
                this,
                "Resident name is missing. Please log in again.",
                "My Status",
                JOptionPane.WARNING_MESSAGE
        );
        return;
    }

    // Load requests directly from the MySQL database.
    MyStatus status = new MyStatus(fullName);
    status.setLocationRelativeTo(null);
    status.setVisible(true);

    this.dispose();
    }                                           

    private void btnLogoutActionPerformed(java.awt.event.ActionEvent evt) {                                          
        LoginJFrame login = new LoginJFrame();
        login.setVisible(true);
        login.pack();
        login.setLocationRelativeTo(null);

      this.dispose();
    }                                         

