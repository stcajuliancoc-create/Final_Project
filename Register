    private void btnSubmitActionPerformed(java.awt.event.ActionEvent evt) {                                          
 String firstName = txtFirstName.getText().trim();
    String lastName = txtLastName.getText().trim();
    String username = txtUsername.getText().trim();
    String password = new String(txtpassword.getPassword());
    String ageText = txtAge.getText().trim();
    String gender = cmbgender.getSelectedItem().toString();
    String address = txtAddress.getText().trim();
    String contact = txtContactNumber.getText().trim();

    if (firstName.isEmpty() || lastName.isEmpty()
            || username.isEmpty() || password.isEmpty()
            || ageText.isEmpty() || gender.isEmpty()
            || address.isEmpty() || contact.isEmpty()) {
        JOptionPane.showMessageDialog(
            this, "Please fill in all fields."
        );
        return;
    }

    if (username.equalsIgnoreCase("admin")) {
        JOptionPane.showMessageDialog(
            this, "The username admin is reserved."
        );
        return;
    }

    int age;
    try {
        age = Integer.parseInt(ageText);
        if (age <= 0) {
            JOptionPane.showMessageDialog(this, "Enter a valid age.");
            return;
        }
    } catch (NumberFormatException e) {
        JOptionPane.showMessageDialog(this, "Age must be a number.");
        return;
    }

    if (!contact.matches("09\\d{9}")) {
        JOptionPane.showMessageDialog(
            this, "Contact number must be 11 digits and start with 09."
        );
        return;
    }

    if (conn == null) {
        JOptionPane.showMessageDialog(
            this, "Database is not connected."
        );
        return;
    }

    String sql = "INSERT INTO residents "
            + "(firstname, lastname, username, password, age, gender, address, contactnumber) "
            + "VALUES (?, ?, ?, ?, ?, ?, ?, ?)";

    try (PreparedStatement pst = conn.prepareStatement(sql)) {
        pst.setString(1, firstName);
        pst.setString(2, lastName);
        pst.setString(3, username);
        pst.setString(4, password);
        pst.setInt(5, age);
        pst.setString(6, gender);
        pst.setString(7, address);
        pst.setString(8, contact);

        pst.executeUpdate();

        JOptionPane.showMessageDialog(
            this, "Registration saved successfully! You can now log in."
        );

        new LoginJFrame().setVisible(true);
        this.dispose();

    } catch (SQLException e) {
        if (e.getErrorCode() == 1062) {
            JOptionPane.showMessageDialog(
                this, "That username already exists. Choose another."
            );
        } else {
            JOptionPane.showMessageDialog(
                this,
                "Registration failed:\n" + e.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }                                         

    }
