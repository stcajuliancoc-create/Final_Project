private void loadResidents() {
    DefaultTableModel model =
            (DefaultTableModel) jTable5.getModel();

    model.setRowCount(0);

    String username = LoginJFrame.currentUsername;

    if (username == null || username.trim().isEmpty()) {
        JOptionPane.showMessageDialog(
                this, "No resident is logged in.");
        return;
    }

    String sql = "SELECT firstname, lastname, username, password, "
            + "age, gender, address, contactnumber "
            + "FROM residents WHERE username = ?";

    try (Connection con = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/barangaycugmanonlinedocumentrequestforms",
            "root", "");
         PreparedStatement pst = con.prepareStatement(sql)) {

        pst.setString(1, username);

        try (ResultSet rs = pst.executeQuery()) {
            if (rs.next()) {
                txtFirstname.setText(rs.getString("firstname"));
                txtlastname.setText(rs.getString("lastname"));
                txtUsername.setText(rs.getString("username"));
                txtPassword.setText(rs.getString("password"));
                txtAge.setText(String.valueOf(rs.getInt("age")));
                txtGender.setText(rs.getString("gender"));
                txtAddress.setText(rs.getString("address"));
                txtContactNumber.setText(
                        rs.getString("contactnumber"));

                model.addRow(new Object[]{
                    rs.getString("firstname"),
                    rs.getString("lastname"),
                    rs.getString("username"),
                    "********",
                    rs.getInt("age"),
                    rs.getString("gender"),
                    rs.getString("address"),
                    rs.getString("contactnumber")
                });
            }
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(
                this,
                "Unable to load information:\n" + e.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE);
    }
}
