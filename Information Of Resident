    private void btnDeleteActionPerformed(java.awt.event.ActionEvent evt) {                                          
        int choice = JOptionPane.showConfirmDialog(
        this,
        "Delete your resident account and information?",
        "Confirm Delete",
        JOptionPane.YES_NO_OPTION
    );

    if (choice != JOptionPane.YES_OPTION) {
        return;
    }

    String sql = "DELETE FROM residents WHERE username = ?";

    try (Connection con = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/barangaycugmanonlinedocumentrequestforms",
            "root", "");
         PreparedStatement pst = con.prepareStatement(sql)) {

        pst.setString(1, LoginJFrame.currentUsername);

        int deleted = pst.executeUpdate();

        if (deleted > 0) {
            JOptionPane.showMessageDialog(this, "Account deleted successfully!");

            LoginJFrame.currentUsername = "";
            new LoginJFrame().setVisible(true);
            this.dispose();
        } else {
            JOptionPane.showMessageDialog(this, "No resident record was found.");
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(
            this, "Delete failed:\n" + e.getMessage()
        );
    }
    }                                         

    private void btnUpdateActionPerformed(java.awt.event.ActionEvent evt) {                                          
        String firstName = txtFirstname.getText().trim();
    String lastName = txtlastname.getText().trim();
    String password = new String(txtPassword.getPassword());
    String ageText = txtAge.getText().trim();
    String gender = txtGender.getText().trim();
    String address = txtAddress.getText().trim();
    String contact = txtContactNumber.getText().trim();

    if (firstName.isEmpty() || lastName.isEmpty()
            || password.isEmpty() || ageText.isEmpty()
            || gender.isEmpty() || address.isEmpty()
            || contact.isEmpty()) {
        JOptionPane.showMessageDialog(this, "Please fill in all fields.");
        return;
    }

    int age;
    try {
        age = Integer.parseInt(ageText);
        if (age <= 0) throw new NumberFormatException();
    } catch (NumberFormatException e) {
        JOptionPane.showMessageDialog(this, "Age must be a positive number.");
        return;
    }

    String sql = "UPDATE residents SET firstname=?, lastname=?, password=?, "
            + "age=?, gender=?, address=?, contactnumber=? WHERE username=?";

    try (Connection con = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/barangaycugmanonlinedocumentrequestforms",
            "root", "");
         PreparedStatement pst = con.prepareStatement(sql)) {

        pst.setString(1, firstName);
        pst.setString(2, lastName);
        pst.setString(3, password);
        pst.setInt(4, age);
        pst.setString(5, gender);
        pst.setString(6, address);
        pst.setString(7, contact);
        pst.setString(8, LoginJFrame.currentUsername);

        int updated = pst.executeUpdate();

        if (updated > 0) {
            loadResidents();
            JOptionPane.showMessageDialog(this, "Information updated successfully!");
        } else {
            JOptionPane.showMessageDialog(this, "No resident record was found.");
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(
            this, "Update failed:\n" + e.getMessage()
        );
    }
    }                                         

    private void btnAddActionPerformed(java.awt.event.ActionEvent evt) {                                       
        String firstName = txtFirstname.getText().trim();
    String lastName = txtlastname.getText().trim();
    String password = new String(txtPassword.getPassword());
    String ageText = txtAge.getText().trim();
    String gender = txtGender.getText().trim();
    String address = txtAddress.getText().trim();
    String contact = txtContactNumber.getText().trim();

    if (firstName.isEmpty() || lastName.isEmpty()
            || password.isEmpty() || ageText.isEmpty()
            || gender.isEmpty() || address.isEmpty()
            || contact.isEmpty()) {
        JOptionPane.showMessageDialog(this, "Please fill in all fields.");
        return;
    }

    int age;
    try {
        age = Integer.parseInt(ageText);
        if (age <= 0) throw new NumberFormatException();
    } catch (NumberFormatException e) {
        JOptionPane.showMessageDialog(this, "Age must be a positive number.");
        return;
    }

    String sql = "INSERT INTO residents "
            + "(firstname, lastname, username, password, age, gender, address, contactnumber) "
            + "VALUES (?, ?, ?, ?, ?, ?, ?, ?)";

    try (Connection con = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/barangaycugmanonlinedocumentrequestforms",
            "root", "");
         PreparedStatement pst = con.prepareStatement(sql)) {

        pst.setString(1, firstName);
        pst.setString(2, lastName);
        pst.setString(3, LoginJFrame.currentUsername);
        pst.setString(4, password);
        pst.setInt(5, age);
        pst.setString(6, gender);
        pst.setString(7, address);
        pst.setString(8, contact);

        pst.executeUpdate();
        loadResidents();

        JOptionPane.showMessageDialog(this, "Information added successfully!");

    } catch (SQLException e) {
        if (e.getErrorCode() == 1062) {
            JOptionPane.showMessageDialog(
                this,
                "Your account already exists. Use Update to change your information."
            );
        } else {
            JOptionPane.showMessageDialog(
                this, "Add failed:\n" + e.getMessage()
            );
        }
    }
    }                                      

