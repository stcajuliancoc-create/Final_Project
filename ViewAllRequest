    private void btnarchiveActionPerformed(java.awt.event.ActionEvent evt) {                                           
        int selectedRow = jTable1.getSelectedRow();

    if (selectedRow == -1) {
        JOptionPane.showMessageDialog(
                this,
                "Please select the request you want to archive."
        );
        return;
    }

    int modelRow =
            jTable1.convertRowIndexToModel(selectedRow);

    Object idValue =
            jTable1.getModel().getValueAt(modelRow, 0);

    if (idValue == null) {
        JOptionPane.showMessageDialog(
                this, "Request ID is missing."
        );
        return;
    }

    int requestId =
            Integer.parseInt(idValue.toString());

    int confirm = JOptionPane.showConfirmDialog(
            this,
            "Archive the selected request (ID: "
                    + requestId + ")?",
            "Confirm Archive",
            JOptionPane.YES_NO_OPTION
    );

    if (confirm != JOptionPane.YES_OPTION) {
        return;
    }

    String url = "jdbc:mysql://localhost:3306/"
            + "barangaycugmanonlinedocumentrequestforms";

    String sql = "UPDATE requestform "
            + "SET is_archived = 1 "
            + "WHERE request_id = ? "
            + "AND is_archived = 0";

    try {
        Class.forName("com.mysql.cj.jdbc.Driver");

        try (Connection connection =
                DriverManager.getConnection(
                        url, "root", "");
             PreparedStatement pst =
                connection.prepareStatement(sql)) {

            pst.setInt(1, requestId);

            int updated = pst.executeUpdate();

            if (updated > 0) {
                JOptionPane.showMessageDialog(
                        this,
                        "Selected request archived successfully!"
                );

                // Remove archived request from active table
                loadRequests();

            } else {
                JOptionPane.showMessageDialog(
                        this,
                        "Request not found or already archived."
                );
            }
        }

    } catch (Exception e) {
        JOptionPane.showMessageDialog(
                this,
                "Archive failed:\n" + e.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE
        );
    }
    }                                          

