private void loadRequests() {
   model.setRowCount(0);

    String url = "jdbc:mysql://localhost:3306/"
            + "barangaycugmanonlinedocumentrequestforms";

    String sql = "SELECT request_id, Residentname, contactnumber, "
        + "document, `date`, `time`, reason, status, comment "
        + "FROM requestform "
        + "WHERE is_archived = 0 "
        + "ORDER BY request_id DESC";
    
    try {
        Class.forName("com.mysql.cj.jdbc.Driver");

        try (java.sql.Connection conn =
                java.sql.DriverManager.getConnection(url, "root", "");
             java.sql.PreparedStatement ps = conn.prepareStatement(sql);
             java.sql.ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                model.addRow(new Object[]{
                    rs.getInt("request_id"),
                    rs.getString("Residentname"),
                    rs.getString("contactnumber"),
                    rs.getString("document"),
                    rs.getString("date"),
                    rs.getString("time"),
                    rs.getString("reason"),
                    rs.getString("status"),
                    rs.getString("comment")
                });
            }
        }

    } catch (Exception ex) {
        JOptionPane.showMessageDialog(
                this,
                "Unable to load requests:\n" + ex.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE
        );
    }
    }

    private void updateSelectedRequest(String newStatus) {

       int selectedRow = jTable1.getSelectedRow();

    if (selectedRow == -1) {
        JOptionPane.showMessageDialog(
                this, "Please select a request first.");
        return;
    }

    int row = jTable1.convertRowIndexToModel(selectedRow);
    int requestId = Integer.parseInt(
            model.getValueAt(row, 0).toString());

    String comment = txtAdminComment.getText().trim();

    if (comment.isEmpty()) {
        JOptionPane.showMessageDialog(
                this, "Please enter an admin comment.");
        txtAdminComment.requestFocus();
        return;
    }

    int confirm = JOptionPane.showConfirmDialog(
            this,
            "Update request status to " + newStatus + "?",
            "Confirm Decision",
            JOptionPane.YES_NO_OPTION
    );

    if (confirm != JOptionPane.YES_OPTION) {
        return;
    }

    String url = "jdbc:mysql://localhost:3306/"
            + "barangaycugmanonlinedocumentrequestforms";

    String sql = "UPDATE requestform "
            + "SET status = ?, comment = ? "
            + "WHERE request_id = ?";

    try {
        Class.forName("com.mysql.cj.jdbc.Driver");

        try (java.sql.Connection conn =
                java.sql.DriverManager.getConnection(url, "root", "");
             java.sql.PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, newStatus);
            ps.setString(2, comment);
            ps.setInt(3, requestId);

            int updated = ps.executeUpdate();

            if (updated > 0) {
                JOptionPane.showMessageDialog(
                        this, "Request updated successfully!");

                txtAdminComment.setText("");
                loadRequests();
            } else {
                JOptionPane.showMessageDialog(
                        this, "Request not found in the database.");
            }

        }

    } catch (Exception ex) {
        JOptionPane.showMessageDialog(
                this,
                "Unable to update request:\n" + ex.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE
        );
    }
    }
