        private void loadArchivedRequests() {
           DefaultTableModel model =
            (DefaultTableModel) jtableArchive.getModel();

    model.setRowCount(0);

    String url = "jdbc:mysql://localhost:3306/"
            + "barangaycugmanonlinedocumentrequestforms";

    String sql = "SELECT request_id, Residentname, document, "
            + "`date`, `time`, reason, status, comment "
            + "FROM requestform "
            + "WHERE is_archived = 1 "
            + "ORDER BY request_id DESC";

    try {
        Class.forName("com.mysql.cj.jdbc.Driver");

        try (java.sql.Connection conn =
                java.sql.DriverManager.getConnection(
                        url, "root", "");
             java.sql.PreparedStatement pst =
                conn.prepareStatement(sql);
             java.sql.ResultSet rs = pst.executeQuery()) {

            while (rs.next()) {
                model.addRow(new Object[]{
                    rs.getInt("request_id"),
                    rs.getString("Residentname"),
                    rs.getString("document"),
                    rs.getString("date"),
                    rs.getString("time"),
                    rs.getString("reason"),
                    rs.getString("status"),
                    rs.getString("comment")
                });
            }

        }

    } catch (Exception e) {
        javax.swing.JOptionPane.showMessageDialog(
                this,
                "Failed to load archived requests:\n"
                + e.getMessage(),
                "Database Error",
                javax.swing.JOptionPane.ERROR_MESSAGE
        );
    } // Generated from nbfs://nbhost/SystemFileSystem/Templates/Classes/Code/GeneratedMethodBody
        }

